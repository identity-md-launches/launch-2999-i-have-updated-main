{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build:client",
  "outputDirectory": "dist/client",
  "build": {
    "env": {
      "BASE_PATH": "/",
      "BACKEND_PORT": "3001"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://squeeklife.surf.computer/api/:path*"
    }
  ]
}
